# Clerk — https://dashboard.clerk.com/~/api-keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk JWT issuer (Frontend API URL) — https://dashboard.clerk.com
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Convex — set by `npx convex dev`; also set in Vercel project env for production
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Write allowlist — set at least one in the Convex dashboard (Settings → Environment Variables).
# Without these, edit access is denied (fail-closed). Mutations and the canEdit query enforce this.
ALLOWED_GITHUB_USERNAME=your-github-username
# ALLOWED_USER_EMAIL=you@example.com
# ALLOWED_CLERK_USER_ID=user_...

# Local dev only: set in Convex dashboard to permit all authenticated users when allowlist vars are unset.
# ALLOW_UNCONFIGURED_ALLOWLIST=true

# GitHub-only allowlist: add githubUsername to your Clerk "convex" JWT template:
# { "githubUsername": "{{user.username}}" }
